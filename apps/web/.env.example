# "hardhat" for a local `npm run node` chain, or "sepolia".
NEXT_PUBLIC_CHAIN=hardhat
# Defaults to the first contract deployed on a fresh local Hardhat node.
NEXT_PUBLIC_LOCATION_DROP_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Optional RPC URL; falls back to the chain's public default.
NEXT_PUBLIC_RPC_URL=
